# X (OAuth 1.0a user context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Meta
META_PAGE_ID=
META_PAGE_TOKEN=
IG_USER_ID=
